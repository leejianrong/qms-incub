<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>{{ title }}</title>
<style>
  body { font-family: 'Helvetica Neue', Arial, sans-serif; color: #1e1b4b; margin: 40px; }
  h1 { font-size: 22px; border-bottom: 2px solid #4338ca; padding-bottom: 8px; }
  table { border-collapse: collapse; width: 100%; margin: 16px 0; }
  th, td { border: 1px solid #94a3b8; padding: 6px 10px; text-align: left; font-size: 12px; }
  th { background: #eef2ff; }
  .block { margin-bottom: 20px; }
  svg { max-width: 100%; }
</style>
</head>
<body>
<h1>{{ title }}</h1>
{% for block in blocks %}
<div class="block">
{% if block.type == "text" %}
  <p>{{ block.content }}</p>
{% elif block.type == "table" %}
  <table>
    <thead><tr>{% for h in block.headers %}<th>{{ h }}</th>{% endfor %}</tr></thead>
    <tbody>
    {% for row in block.rows %}
      <tr>{% for cell in row %}<td>{{ cell }}</td>{% endfor %}</tr>
    {% endfor %}
    </tbody>
  </table>
{% elif block.type == "flowchart" %}
  {{ block.svg | safe }}
{% elif block.type == "image" %}
  <img src="{{ block.data_uri }}" alt="{{ block.alt_text }}">
{% endif %}
</div>
{% endfor %}
</body>
</html>
