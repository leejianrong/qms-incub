# Copy to backend/.env for local overrides (gitignored — never commit real
# secrets). Defaults match `make up` (ADR-0009) and local Ollama dev.

# --- LLM provider (Q37, QUESTIONS.md) ---
# "ollama": local, no API key, uses the model already pulled via `ollama
#   pull <model>`. Good default for dev/testing without spending anything.
# "openrouter": ADR-0003's decided default — needs OPENROUTER_API_KEY below.
# "zenmux": PROMOTIONAL WINDOW ONLY, 2026-09-01 through 2026-09-05 (Q39) —
#   a ZenMux API key was sent to the team separately for this window only.
#   Prefer this while the window is open; from 2026-09-06 switch back to
#   "openrouter" (preferred) or "ollama" — see README.md/CLAUDE.md.
LLM_PROVIDER=ollama

OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# Get a key at https://openrouter.ai/keys — only needed when LLM_PROVIDER=openrouter.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Kept cheap on purpose — override if you want a different model.
OPENROUTER_MODEL=deepseek/deepseek-chat

# Q39: promotional-window provider (2026-09-01 through 2026-09-05 only) —
# needs ZENMUX_API_KEY below, sent to the team separately for this window.
ZENMUX_API_KEY=
ZENMUX_BASE_URL=https://zenmux.ai/api/v1
# Kept cheap on purpose — override if you want a different model. (ZenMux
# retired the old "deepseek/deepseek-chat" alias on 2026-07-24.)
ZENMUX_MODEL=deepseek/deepseek-v4-flash

# --- RAG ingestion/retrieval ---
# Embedding provider (Q36, QUESTIONS.md), same swap pattern as LLM_PROVIDER.
# "local" (default): HuggingFace model below, downloaded once, runs
#   in-process, no API key needed, no GPU required (BAAI/bge-small-en-v1.5
#   is small enough to be fast on CPU).
# "openrouter" / "zenmux": hosted OpenAI-compatible /embeddings endpoint —
#   nothing to run locally, but a network call per chunk/query, and reuses
#   that provider's API key from the LLM section above. Switching providers
#   changes vector dimensionality, so the Qdrant collection needs
#   re-ingesting afterward — unlike RETRIEVAL_MODE, this is not a hot-swap.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
ZENMUX_EMBEDDING_MODEL=openai/text-embedding-3-small

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=qms_incub_corpus

# --- Retrieval (S8) ---
# "bm25" (default): sparse lexical retrieval. "vector": dense embedding
# similarity (EMBEDDING_MODEL above). Both query QDRANT_COLLECTION —
# ingestion writes both a dense and a BM25 sparse vector per chunk, so
# switching modes needs no re-ingest. A fused hybrid mode (both signals
# combined into one ranking) is deferred — issue #53.
RETRIEVAL_MODE=bm25
# fastembed sparse model — ingestion and retrieval must use the same one.
SPARSE_EMBEDDING_MODEL=Qdrant/bm25
# Candidates fetched before the reranker trims to top_k.
RETRIEVAL_CANDIDATE_K=20

# --- Reranker (Q19) ---
# "none" (default): passthrough, keep BM25's own order.
# "zenmux": ZenMux's hosted cross-encoder /rerank endpoint — cheap, no LLM
#   tokens spent, reuses ZENMUX_API_KEY from the LLM section above.
# "llm": prompts whichever LLM_PROVIDER is already configured
#   (ollama/openrouter/zenmux) to rank the candidates instead — no
#   dedicated rerank API needed, at the cost of an extra LLM call.
# Either real provider degrades to "none" with a warning if its
# credentials aren't set, so local dev keeps working without extra setup.
RERANKER_PROVIDER=none
RERANKER_MODEL=qwen/qwen3-rerank
ZENMUX_RERANK_URL=https://zenmux.ai/api/v1/rerank
RERANKER_TIMEOUT_S=30

# --- Relational data (V5) ---
# Matches docker-compose.yml's postgres service.
DATABASE_URL=postgresql+psycopg://qms_incub:qms_incub@localhost:5433/qms_incub
