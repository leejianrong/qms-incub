# Copy to backend/.env for local overrides (gitignored — never commit real
# secrets). Defaults match `make up` (ADR-0009) and local Ollama dev.

# --- LLM provider (Q37, QUESTIONS.md) ---
# "ollama": local, no API key, uses the model already pulled via `ollama
#   pull <model>`. Good default for dev/testing without spending anything.
# "openrouter": ADR-0003's decided default — needs OPENROUTER_API_KEY below.
# "zenmux": PROMOTIONAL WINDOW ONLY, 2026-09-01 through 2026-09-05 (Q39) —
#   a ZenMux API key was sent to the team separately for this window only.
#   Prefer this while the window is open; from 2026-09-06 switch back to
#   "openrouter" (preferred) or "ollama" — see README.md/CLAUDE.md.
LLM_PROVIDER=ollama

OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# Get a key at https://openrouter.ai/keys — only needed when LLM_PROVIDER=openrouter.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Kept cheap on purpose — override if you want a different model.
OPENROUTER_MODEL=deepseek/deepseek-chat

# Q39: promotional-window provider (2026-09-01 through 2026-09-05 only) —
# needs ZENMUX_API_KEY below, sent to the team separately for this window.
ZENMUX_API_KEY=
ZENMUX_BASE_URL=https://zenmux.ai/api/
# Kept cheap on purpose — override if you want a different model.
ZENMUX_MODEL=deepseek/deepseek-chat

# --- RAG ingestion/retrieval ---
# Local HuggingFace embedding model (Q36, QUESTIONS.md) — downloaded once,
# runs in-process, no API key needed.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=qms_incub_corpus

# --- Retrieval (S8) ---
# "hybrid" (dense + BM25 fused), "dense", or "bm25". All run against
# QDRANT_COLLECTION, which must be ingested with hybrid enabled.
RETRIEVAL_MODE=hybrid
# fastembed sparse model — ingestion and retrieval must use the same one.
SPARSE_EMBEDDING_MODEL=Qdrant/bm25
# Hybrid fusion weight: 1.0 = all dense, 0.0 = all BM25.
HYBRID_ALPHA=0.5
# Candidates fetched before the reranker trims to top_k.
RETRIEVAL_CANDIDATE_K=20

# --- Reranker (Q19) ---
# "zenmux": hosted rerank API — reuses ZENMUX_API_KEY from the LLM section
#   above; without a key, reranking is silently skipped. "none": disable.
RERANKER_PROVIDER=none
RERANKER_MODEL=qwen/qwen3-rerank
ZENMUX_RERANK_URL=https://zenmux.ai/api/v1/rerank
RERANKER_TIMEOUT_S=30

# --- Relational data (V5) ---
# Matches docker-compose.yml's postgres service.
DATABASE_URL=postgresql+psycopg://qms_incub:qms_incub@localhost:5433/qms_incub
