# Copy to .env for local overrides (gitignored). Read by both `docker
# compose` (interpolates ${APP_PORT} in docker-compose.yml) and the
# Makefile (curl-based seed targets), so there's exactly one place to
# change if the default port is already taken on your machine — no code
# edit, no strictPort failure.

# The only port `make up` publishes to the host. nginx (the `proxy`
# service) listens here and routes `/` to the Vite dev server and `/api/*`
# to the FastAPI backend, so the browser only ever talks to one origin —
# see ADR-0017.
APP_PORT=5173
