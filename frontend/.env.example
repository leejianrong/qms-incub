# Copy to .env.local for local overrides. This is the host-only
# `make frontend-dev` default. `make up`'s Dockerized frontend overrides
# this to `/api` (routed by the nginx proxy — see nginx/default.conf and
# ADR-0017) directly in docker-compose.yml, so this file doesn't need to
# change for the Docker path.
VITE_API_BASE=http://localhost:8000
