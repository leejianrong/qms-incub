# Copy to rag-eval/.env for local runs (gitignored — never commit real
# secrets). rag-eval imports qms_incub.config.settings directly, and
# pydantic-settings resolves `env_file=".env"` relative to the current
# working directory — so running `uv run python -m rag_eval` from
# rag-eval/ reads *this* directory's .env, not backend/.env. Keep the
# values here identical to whatever backend/.env actually used to ingest
# the corpus you're scoring: a mismatch (e.g. eval set to EMBEDDING_PROVIDER
# =zenmux against a collection ingested with the local model) doesn't error
# loudly, it just quietly scores nonsense. See ../backend/.env.example for
# the full description of every variable — this is the subset rag-eval's
# RetrievalPort actually reads (no DATABASE_URL: rag-eval never touches
# Postgres).

# --- Embeddings (Q36) — only matters when RETRIEVAL_MODE=vector below ---
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
ZENMUX_EMBEDDING_MODEL=openai/text-embedding-3-small

# Needed only if EMBEDDING_PROVIDER (or RERANKER_PROVIDER/LLM_PROVIDER
# below) is "openrouter" / "zenmux".
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ZENMUX_API_KEY=
ZENMUX_BASE_URL=https://zenmux.ai/api/v1

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=qms_incub_corpus

# "bm25" (default): sparse lexical — ignores EMBEDDING_PROVIDER entirely.
# "vector": dense embedding similarity (EMBEDDING_PROVIDER/EMBEDDING_MODEL
# above). Both query the same collection.
RETRIEVAL_MODE=bm25
SPARSE_EMBEDDING_MODEL=Qdrant/bm25
RETRIEVAL_CANDIDATE_K=20

# --- Reranker (Q19) — the harness reranks by default; pass --no-rerank
# to skip it instead of setting this to "none" ---
# "none": passthrough. "zenmux": ZenMux's hosted rerank endpoint (needs
# ZENMUX_API_KEY above). "llm": prompts whichever LLM_PROVIDER is set
# below to rank candidates — the only way this bench exercises an LLM at
# all, since the harness never calls /chat.
RERANKER_PROVIDER=none
RERANKER_MODEL=qwen/qwen3-rerank
ZENMUX_RERANK_URL=https://zenmux.ai/api/v1/rerank
RERANKER_TIMEOUT_S=30

# Only read when RERANKER_PROVIDER=llm.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
OPENROUTER_MODEL=deepseek/deepseek-chat
ZENMUX_MODEL=deepseek/deepseek-v4-flash
